# ============================================================
# AUTO — Marketing Team  |  Environment variables (v0.2, fully integrated)
# Copy to `.env.local` and fill in ONE platform at a time:
#   cp .env.example .env.local
#
# ★ To start, you still need NOTHING (free demo mode + manual posting).
# ★ NEVER commit .env.local  ★ NEVER share keys in chat/GitHub
# ★ End-to-end test guide: TESTING.md  |  Background: CREDENTIALS.md
# Connecting a platform = EITHER an access token below OR the
# OAuth "Connect" button (app id/secret). Env tokens win if both exist.
# ============================================================

# ---------- 0) APP SECURITY ----------
# Public base URL of the app. MUST match the OAuth redirect URIs you
# register: {NEXT_PUBLIC_APP_URL}/api/oauth/{provider}/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
# OAUTH_REDIRECT_BASE_URL=            # override if different from above
SESSION_SECRET=                       # 32+ random chars — encrypts OAuth tokens. REQUIRED in production.
PUBLISH_SECRET=                       # optional — if set, the UI asks for it before Publish/Test calls.

# ---------- 1) AI PROVIDER — pick ONE free option ----------
GEMINI_API_KEY=                       # https://aistudio.google.com/apikey (free tier)
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=                         # https://console.groq.com/keys (free, no card)
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=                   # https://openrouter.ai/keys (models ending :free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_API_KEY=                       # paid, optional
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=                          # gemini|groq|openrouter|openai|demo (blank = auto)

# ============================================================
# 2) META — Instagram (Carousel + Reel)   [free, App Review]
# App: https://developers.facebook.com/apps
# Needs: Instagram Business/Creator account linked to a Facebook Page.
# Fast test path: Graph API Explorer token + your IG user id.
# Scopes: instagram_basic + instagram_content_publish (+pages_*)
# ============================================================
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v25.0
# META_OAUTH_SCOPES=instagram_basic,instagram_content_publish,pages_show_list,pages_read_engagement

# ============================================================
# 3) THREADS   [free, App Review]  (separate app id from Meta app)
# App dashboard -> Threads use case. Scopes: threads_basic,
# threads_content_publish, threads_manage_insights
# ============================================================
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ============================================================
# 4) YOUTUBE SHORTS   [free quota, OAuth]
# Google Cloud -> enable "YouTube Data API v3" -> OAuth client.
# Easiest refresh token: Google OAuth Playground (scope youtube.upload)
# or just use the Connect (Google) button. Privacy default = private.
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_ACCESS_TOKEN=
YOUTUBE_PRIVACY=private
# YOUTUBE_CATEGORY_ID=22
# YOUTUBE_MADE_FOR_KIDS=false

# ============================================================
# 5) LINKEDIN   [free; own-profile posting is self-serve]
# App: https://www.linkedin.com/developers/apps -> add products
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn".
# Tokens last ~60 days. Company Pages need extra approval
# (then set LINKEDIN_AUTHOR_URN=urn:li:organization:{id}).
# ============================================================
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# LINKEDIN_AUTHOR_URN=
# LINKEDIN_API_VERSION=202510

# ============================================================
# 6) TIKTOK   [free; PUBLIC posting needs TikTok audit]
# App: https://developers.tiktok.com -> Content Posting API.
# Unaudited apps can only post SELF_ONLY (private) — safe default.
# FILE_UPLOAD = server downloads your media URL then uploads it.
# PULL_FROM_URL = TikTok fetches it (needs your domain verified).
# ============================================================
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
TIKTOK_SOURCE=FILE_UPLOAD

# ============================================================
# 7) X / TWITTER   [⚠️ PAID pay-per-use — manual posting = free]
# App: https://developer.x.com  (App permissions: Read + Write)
# OAuth 1.0a set (below) OR OAuth2 Connect via X_CLIENT_ID/SECRET.
# ============================================================
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_BEARER_TOKEN=                     # app-only reads; NOT used for posting
X_PUBLISH_MODE=thread                 # thread | single

# ============================================================
# 8) PINTEREST   [free; Trial = sandbox hidden pins]
# App: https://developers.pinterest.com/apps
# Scopes: boards:read boards:write pins:read pins:write user_accounts:read
# PINTEREST_ENV=sandbox while on Trial access.
# ============================================================
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
# PINTEREST_REFRESH_TOKEN=
# PINTEREST_BOARD_ID=
# PINTEREST_ENV=sandbox

# ============================================================
# 9) REDDIT   [needs PRE-APPROVED app; manual posting recommended]
# Approval: Reddit Responsible Builder Policy (new apps are gated).
# Token order: REDDIT_ACCESS_TOKEN > refresh > username/password (script apps).
# ============================================================
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_ACCESS_TOKEN=
# REDDIT_REFRESH_TOKEN=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=
REDDIT_USER_AGENT=web:auto-marketing-team:v0.2.0 (by /u/YOUR_USERNAME)

# ============================================================
# 10) OPTIONAL LATER — database for multi-device sync (not wired yet)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=

# ============================================================
# 11) ADVANCED / TESTING (normally leave alone)
# Override API hosts (used by scripts/test-integrations.mjs mock):
# META_GRAPH_BASE=  THREADS_GRAPH_BASE=  YOUTUBE_API_BASE=  GOOGLE_TOKEN_URL=
# LINKEDIN_API_BASE=  LINKEDIN_TOKEN_URL=  TIKTOK_API_BASE=  X_API_BASE=
# X_UPLOAD_BASE=  X_TOKEN_URL=  PINTEREST_API_BASE=  REDDIT_API_BASE=  REDDIT_OAUTH_BASE=
# SOCIAL_POLL_ATTEMPTS=10
# SOCIAL_POLL_INTERVAL_MS=4000
# ALLOW_PRIVATE_MEDIA_URLS=           # 1 = allow localhost media URLs (TESTS ONLY — never in prod)
# YOUTUBE_MAX_UPLOAD_MB=100
# ============================================================
